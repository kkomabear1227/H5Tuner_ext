<Parameters>
	<High_Level_IO_Library>
		<sieve_buf_size>262144</sieve_buf_size>
		<alignment>524288,262144 </alignment>
		<!-- H5Pset_alignment function gets 2 args: (Threshold, Alignment) -->
		<!-- Added 2026-08-13.  All five reach fapl_id through
		     set_hdf5_parameter() in src/autotuner_hdf5.c. -->
		<meta_block_size>262144</meta_block_size>
		<!-- H5Pset_cache: only rdcc_nbytes is tuned; the slot count and the
		     preemption policy keep whatever the property list already holds. -->
		<chunk_cache>16777216</chunk_cache>
		<!-- The next two need HDF5 1.10.0 or later.  On an older build the shim
		     warns and skips them rather than failing to compile. -->
		<coll_metadata_write>1</coll_metadata_write>
		<col_meta_ops>1</col_meta_ops>
		<!-- Named preset, not the full H5AC_cache_config_t struct.
		     One of: default, aggressive, conservative. -->
		<mdc_conf>default</mdc_conf>
	</High_Level_IO_Library>

	<Middleware_Layer>
		<cb_buffer_size>4194304</cb_buffer_size>
		<cb_nodes>32</cb_nodes>
	</Middleware_Layer>

	<Parallel_File_System>
		<striping_factor>4</striping_factor>
		<striping_unit>65536</striping_unit>
	</Parallel_File_System>
</Parameters>
